# ── Frontend environment template ─────────────────────────────────────────────
# Copy to `.env` for local development (or set in the deploy environment).
# Production builds read VITE_API_URL from the Vercel environment variables —
# never from a local .env.production (see DEPLOYMENT.md §6).

# Backend origin (no path). REST API is appended with /api automatically.
# Development:   http://localhost:5000
# Production:    https://backend-host-url
VITE_API_URL=