# ── Backend environment template ──────────────────────────────────────────────
# Copy to `.env` and fill in real values. Never commit real secrets.

# Server
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT signing secret (min 16 chars)
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed CORS origins (no trailing spaces)
# Example: http://localhost:5173,https://frontend-host-url
CORS_ORIGIN=http://localhost:5173

# Reverse-proxy awareness for IP-based rate limiting.
# Only set when the backend runs behind a real proxy (Render/Railway/Cloudflare/Nginx).
#   TRUST_PROXY=1          (one proxy hop)
#   TRUST_PROXY=true
# Leave unset when exposed directly. Do NOT enable blindly.
#TRUST_PROXY=

# Storage
#   local     = filesystem ./uploads (development default)
#   supabase  = Supabase Storage (S3-compatible). Requires the SUPABASE_S3_* variables.
#               Startup fails if STORAGE_PROVIDER=supabase and a variable is missing.
#   r2        = Cloudflare R2 (S3-compatible, legacy). Requires the R2_* variables.
STORAGE_PROVIDER=local

# Supabase Storage (S3-compatible API)
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-2
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=Sociafy-uploads
# Public base URL for the public bucket (NOT the S3 API endpoint):
# https://<project-ref>.supabase.co/storage/v1/object/public/Sociafy-uploads
SUPABASE_STORAGE_PUBLIC_URL=

# Cloudflare R2 (legacy; keep only if still used)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional: seed an admin account on first boot
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
# SEED_ADMIN_ROLE=admin